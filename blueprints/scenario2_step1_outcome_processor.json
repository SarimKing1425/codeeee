{
  "name": "BMC - Scenario 2 - Step 1 Outcome Webhook",
  "flow": [
    {
      "id": 1,
      "module": "gateway:CustomWebHook",
      "version": 1,
      "parameters": { "hook": null, "maxResults": 1 },
      "mapper": {},
      "metadata": {
        "designer": { "x": 0, "y": 0 },
        "restore": { "parameters": { "hook": { "label": "VAPI Step 1 Webhook" } } },
        "expect": [ { "name": "hook", "type": "hook:gateway-webhook", "label": "Webhook", "required": true } ]
      }
    },
    {
      "id": 2,
      "module": "builtin:BasicFilter",
      "version": 1,
      "filter": {
        "name": "Only end-of-call-report",
        "conditions": [
          [ { "a": "{{1.message.type}}", "o": "text:equal", "b": "end-of-call-report" } ]
        ]
      },
      "metadata": { "designer": { "x": 300, "y": 0 } }
    },
    {
      "id": 3,
      "module": "builtin:BasicRouter",
      "version": 1,
      "mapper": null,
      "metadata": { "designer": { "x": 600, "y": 0 } },
      "routes": [
        {
          "flow": [
            {
              "id": 10,
              "module": "google-sheets:updateRow",
              "version": 4,
              "parameters": { "__IMTCONN__": null },
              "filter": {
                "name": "Not Interested -> Dead",
                "conditions": [
                  [ { "a": "{{1.message.analysis.structuredData.outcome}}", "o": "text:equal", "b": "Not Interested" } ]
                ]
              },
              "mapper": {
                "mode": "select",
                "spreadsheetId": "1dl-TPKYxwdgSVsvfYQ8skBEslk4cVjR9x7RfqDJsuiU",
                "sheetId": "Lead Master",
                "includesHeaders": true,
                "rowNumber": "{{1.message.call.metadata.sheetRowNumber}}",
                "values": {
                  "6": "Dead",
                  "8": "{{formatDate(now; \"YYYY-MM-DD HH:mm\"; \"Asia/Dubai\")}}"
                },
                "valueInputOption": "USER_ENTERED"
              },
              "metadata": { "designer": { "x": 900, "y": -400 } }
            }
          ]
        },
        {
          "flow": [
            {
              "id": 20,
              "module": "google-sheets:updateRow",
              "version": 4,
              "parameters": { "__IMTCONN__": null },
              "filter": {
                "name": "Speak Now -> immediate Step 2",
                "conditions": [
                  [ { "a": "{{1.message.analysis.structuredData.speak_now}}", "o": "text:equal", "b": "true" } ]
                ]
              },
              "mapper": {
                "mode": "select",
                "spreadsheetId": "1dl-TPKYxwdgSVsvfYQ8skBEslk4cVjR9x7RfqDJsuiU",
                "sheetId": "Lead Master",
                "includesHeaders": true,
                "rowNumber": "{{1.message.call.metadata.sheetRowNumber}}",
                "values": {
                  "6": "Speak Now",
                  "8": "{{formatDate(now; \"YYYY-MM-DD HH:mm\"; \"Asia/Dubai\")}}",
                  "12": "Yes"
                },
                "valueInputOption": "USER_ENTERED"
              },
              "metadata": { "designer": { "x": 900, "y": -200 } }
            },
            {
              "id": 21,
              "module": "google-sheets:getRangeValues",
              "version": 4,
              "parameters": { "__IMTCONN__": null },
              "mapper": {
                "mode": "select",
                "spreadsheetId": "1dl-TPKYxwdgSVsvfYQ8skBEslk4cVjR9x7RfqDJsuiU",
                "sheetId": "Lead Master",
                "range": "A{{1.message.call.metadata.sheetRowNumber}}:F{{1.message.call.metadata.sheetRowNumber}}",
                "valueRenderOption": "FORMATTED_VALUE",
                "dateTimeRenderOption": "FORMATTED_STRING"
              },
              "metadata": { "designer": { "x": 1200, "y": -200 } }
            },
            {
              "id": 22,
              "module": "http:ActionSendData",
              "version": 3,
              "parameters": { "handleErrors": true },
              "mapper": {
                "url": "https://api.vapi.ai/call",
                "method": "POST",
                "headers": [
                  { "name": "Authorization", "value": "Bearer REPLACE_WITH_VAPI_API_KEY" },
                  { "name": "Content-Type", "value": "application/json" }
                ],
                "bodyType": "raw",
                "contentType": "application/json",
                "parseResponse": true,
                "data": "{\n  \"assistantId\": \"af6ed5d3-741d-4b2d-b036-6868922df56e\",\n  \"phoneNumberId\": \"REPLACE_WITH_VAPI_PHONE_NUMBER_ID\",\n  \"customer\": {\n    \"number\": \"+{{replace(21.values[0][2]; \"+\"; \"\")}}\",\n    \"name\": \"{{21.values[0][1]}}\"\n  },\n  \"assistantOverrides\": {\n    \"variableValues\": {\n      \"name\": \"{{21.values[0][1]}}\",\n      \"company\": \"{{21.values[0][3]}}\",\n      \"partner_name\": \"{{21.values[0][4]}}\"\n    }\n  },\n  \"metadata\": {\n    \"sheetRowNumber\": \"{{1.message.call.metadata.sheetRowNumber}}\",\n    \"leadEmail\": \"{{21.values[0][5]}}\",\n    \"step\": \"2\"\n  }\n}"
              },
              "metadata": { "designer": { "x": 1500, "y": -200 } }
            }
          ]
        },
        {
          "flow": [
            {
              "id": 30,
              "module": "google-sheets:updateRow",
              "version": 4,
              "parameters": { "__IMTCONN__": null },
              "filter": {
                "name": "Scheduled -> write preferred datetime",
                "conditions": [
                  [ { "a": "{{1.message.analysis.structuredData.outcome}}", "o": "text:equal", "b": "Scheduled" } ]
                ]
              },
              "mapper": {
                "mode": "select",
                "spreadsheetId": "1dl-TPKYxwdgSVsvfYQ8skBEslk4cVjR9x7RfqDJsuiU",
                "sheetId": "Lead Master",
                "includesHeaders": true,
                "rowNumber": "{{1.message.call.metadata.sheetRowNumber}}",
                "values": {
                  "6": "Scheduled",
                  "8": "{{formatDate(now; \"YYYY-MM-DD HH:mm\"; \"Asia/Dubai\")}}",
                  "10": "{{1.message.analysis.structuredData.preferred_time}}",
                  "11": "{{1.message.analysis.structuredData.preferred_datetime_iso}}"
                },
                "valueInputOption": "USER_ENTERED"
              },
              "metadata": { "designer": { "x": 900, "y": 0 } }
            }
          ]
        },
        {
          "flow": [
            {
              "id": 40,
              "module": "google-sheets:getRangeValues",
              "version": 4,
              "parameters": { "__IMTCONN__": null },
              "filter": {
                "name": "No Answer / Busy - read current attempt count",
                "conditions": [
                  [
                    { "a": "{{1.message.analysis.structuredData.outcome}}", "o": "text:equal", "b": "No Answer", "or": true },
                    { "a": "{{1.message.analysis.structuredData.outcome}}", "o": "text:equal", "b": "Busy", "or": true }
                  ]
                ]
              },
              "mapper": {
                "mode": "select",
                "spreadsheetId": "1dl-TPKYxwdgSVsvfYQ8skBEslk4cVjR9x7RfqDJsuiU",
                "sheetId": "Lead Master",
                "range": "H{{1.message.call.metadata.sheetRowNumber}}:H{{1.message.call.metadata.sheetRowNumber}}",
                "valueRenderOption": "UNFORMATTED_VALUE",
                "dateTimeRenderOption": "FORMATTED_STRING"
              },
              "metadata": { "designer": { "x": 900, "y": 300 } }
            },
            {
              "id": 41,
              "module": "builtin:BasicRouter",
              "version": 1,
              "mapper": null,
              "metadata": { "designer": { "x": 1200, "y": 300 } },
              "routes": [
                {
                  "flow": [
                    {
                      "id": 42,
                      "module": "google-sheets:updateRow",
                      "version": 4,
                      "parameters": { "__IMTCONN__": null },
                      "filter": {
                        "name": "Attempt < 3 -> increment and retry",
                        "conditions": [
                          [ { "a": "{{parseNumber(40.values[0][0])}}", "o": "number:less", "b": "3" } ]
                        ]
                      },
                      "mapper": {
                        "mode": "select",
                        "spreadsheetId": "1dl-TPKYxwdgSVsvfYQ8skBEslk4cVjR9x7RfqDJsuiU",
                        "sheetId": "Lead Master",
                        "includesHeaders": true,
                        "rowNumber": "{{1.message.call.metadata.sheetRowNumber}}",
                        "values": {
                          "6": "Attempting",
                          "7": "{{parseNumber(40.values[0][0]) + 1}}",
                          "8": "{{formatDate(now; \"YYYY-MM-DD HH:mm\"; \"Asia/Dubai\")}}"
                        },
                        "valueInputOption": "USER_ENTERED"
                      },
                      "metadata": { "designer": { "x": 1500, "y": 200 } }
                    },
                    {
                      "id": 43,
                      "module": "util:Sleep",
                      "version": 1,
                      "parameters": {},
                      "mapper": { "duration": "300" },
                      "metadata": {
                        "designer": { "x": 1800, "y": 200 },
                        "restore": { "parameters": { "duration": { "label": "Sleep (max 300s). For 60-min delay, replace with a Tools > Set Variable + status flag, then let Scenario 1 re-pick the row." } } }
                      }
                    },
                    {
                      "id": 44,
                      "module": "google-sheets:getRangeValues",
                      "version": 4,
                      "parameters": { "__IMTCONN__": null },
                      "mapper": {
                        "mode": "select",
                        "spreadsheetId": "1dl-TPKYxwdgSVsvfYQ8skBEslk4cVjR9x7RfqDJsuiU",
                        "sheetId": "Lead Master",
                        "range": "A{{1.message.call.metadata.sheetRowNumber}}:F{{1.message.call.metadata.sheetRowNumber}}",
                        "valueRenderOption": "FORMATTED_VALUE"
                      },
                      "metadata": { "designer": { "x": 2100, "y": 200 } }
                    },
                    {
                      "id": 45,
                      "module": "http:ActionSendData",
                      "version": 3,
                      "parameters": { "handleErrors": true },
                      "mapper": {
                        "url": "https://api.vapi.ai/call",
                        "method": "POST",
                        "headers": [
                          { "name": "Authorization", "value": "Bearer REPLACE_WITH_VAPI_API_KEY" },
                          { "name": "Content-Type", "value": "application/json" }
                        ],
                        "bodyType": "raw",
                        "contentType": "application/json",
                        "parseResponse": true,
                        "data": "{\n  \"assistantId\": \"5950913e-bc1b-4d6a-a51c-5988fd899a9b\",\n  \"phoneNumberId\": \"REPLACE_WITH_VAPI_PHONE_NUMBER_ID\",\n  \"customer\": {\n    \"number\": \"+{{replace(44.values[0][2]; \"+\"; \"\")}}\",\n    \"name\": \"{{44.values[0][1]}}\"\n  },\n  \"assistantOverrides\": {\n    \"variableValues\": {\n      \"name\": \"{{44.values[0][1]}}\",\n      \"company\": \"{{44.values[0][3]}}\",\n      \"partner_name\": \"{{44.values[0][4]}}\"\n    }\n  },\n  \"metadata\": {\n    \"sheetRowNumber\": \"{{1.message.call.metadata.sheetRowNumber}}\",\n    \"leadEmail\": \"{{44.values[0][5]}}\",\n    \"step\": \"1-retry\"\n  }\n}"
                      },
                      "metadata": { "designer": { "x": 2400, "y": 200 } }
                    }
                  ]
                },
                {
                  "flow": [
                    {
                      "id": 46,
                      "module": "google-sheets:updateRow",
                      "version": 4,
                      "parameters": { "__IMTCONN__": null },
                      "filter": {
                        "name": "Attempt >= 3 -> Dead",
                        "conditions": [
                          [ { "a": "{{parseNumber(40.values[0][0])}}", "o": "number:greaterorequal", "b": "3" } ]
                        ]
                      },
                      "mapper": {
                        "mode": "select",
                        "spreadsheetId": "1dl-TPKYxwdgSVsvfYQ8skBEslk4cVjR9x7RfqDJsuiU",
                        "sheetId": "Lead Master",
                        "includesHeaders": true,
                        "rowNumber": "{{1.message.call.metadata.sheetRowNumber}}",
                        "values": {
                          "6": "Dead",
                          "8": "{{formatDate(now; \"YYYY-MM-DD HH:mm\"; \"Asia/Dubai\")}}"
                        },
                        "valueInputOption": "USER_ENTERED"
                      },
                      "metadata": { "designer": { "x": 1500, "y": 400 } }
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ],
  "metadata": {
    "instant": true,
    "version": 1,
    "scenario": {
      "roundtrips": 1,
      "maxErrors": 3,
      "autoCommit": true,
      "autoCommitTriggerLast": true,
      "sequential": false,
      "confidential": false,
      "dataloss": false,
      "dlq": false,
      "freshVariables": false
    },
    "designer": { "orphans": [] },
    "zone": "eu1.make.com",
    "notes": []
  }
}
