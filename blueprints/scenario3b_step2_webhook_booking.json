{
  "name": "BMC - Scenario 3b - Step 2 Outcome Webhook (Booking / Busy / Not Interested)",
  "flow": [
    {
      "id": 1,
      "module": "gateway:CustomWebHook",
      "version": 1,
      "parameters": { "hook": null, "maxResults": 1 },
      "mapper": {},
      "metadata": {
        "designer": { "x": 0, "y": 0 },
        "restore": { "parameters": { "hook": { "label": "VAPI Step 2 Webhook" } } },
        "expect": [ { "name": "hook", "type": "hook:gateway-webhook", "label": "Webhook", "required": true } ]
      }
    },
    {
      "id": 2,
      "module": "builtin:BasicFilter",
      "version": 1,
      "filter": {
        "name": "Only end-of-call-report",
        "conditions": [
          [ { "a": "{{1.message.type}}", "o": "text:equal", "b": "end-of-call-report" } ]
        ]
      },
      "metadata": { "designer": { "x": 300, "y": 0 } }
    },
    {
      "id": 3,
      "module": "builtin:BasicRouter",
      "version": 1,
      "mapper": null,
      "metadata": { "designer": { "x": 600, "y": 0 } },
      "routes": [
        {
          "flow": [
            {
              "id": 10,
              "module": "google-calendar:createAnEvent",
              "version": 5,
              "parameters": { "__IMTCONN__": null },
              "filter": {
                "name": "Booked",
                "conditions": [
                  [ { "a": "{{1.message.analysis.structuredData.outcome}}", "o": "text:equal", "b": "Booked" } ]
                ]
              },
              "mapper": {
                "select": "detail",
                "duration": false,
                "calendar": "primary",
                "summary": "BMC Discovery Call - {{1.message.call.customer.name}}",
                "description": "Lead: {{1.message.call.customer.name}}\nPhone: {{1.message.call.customer.number}}\nEmail: {{1.message.call.metadata.leadEmail}}\n\nPain Point 1: {{1.message.analysis.structuredData.pain_point_1}}\nPain Point 2: {{1.message.analysis.structuredData.pain_point_2}}\nLead Score: {{1.message.analysis.structuredData.lead_score}}\n\nBooked automatically by Sapna (BMC Step 2 agent).",
                "start": "{{1.message.analysis.structuredData.meeting_datetime}}",
                "end": "{{formatDate(addMinutes(parseDate(1.message.analysis.structuredData.meeting_datetime; \"YYYY-MM-DDTHH:mm:ssZ\"); 30); \"YYYY-MM-DDTHH:mm:ssZ\")}}",
                "allDay": false,
                "attendees": [ { "email": "{{1.message.call.metadata.leadEmail}}" } ],
                "sendUpdates": "all",
                "guestPermissions": { "guestsCanModify": false, "guestsCanInviteOthers": true, "guestsCanSeeOtherGuests": true },
                "visibility": "default",
                "transparency": "opaque",
                "conferenceDate": true
              },
              "metadata": { "designer": { "x": 900, "y": -400 } }
            },
            {
              "id": 11,
              "module": "google-sheets:updateRow",
              "version": 4,
              "parameters": { "__IMTCONN__": null },
              "mapper": {
                "mode": "select",
                "spreadsheetId": "1dl-TPKYxwdgSVsvfYQ8skBEslk4cVjR9x7RfqDJsuiU",
                "sheetId": "Lead Master",
                "includesHeaders": true,
                "rowNumber": "{{1.message.call.metadata.sheetRowNumber}}",
                "values": {
                  "6": "Booked",
                  "8": "{{formatDate(now; \"YYYY-MM-DD HH:mm\"; \"Asia/Dubai\")}}",
                  "13": "{{1.message.analysis.structuredData.pain_point_1}} {{1.message.analysis.structuredData.pain_point_2}}",
                  "14": "{{1.message.analysis.structuredData.lead_score}}",
                  "15": "{{1.message.analysis.structuredData.meeting_datetime}}",
                  "16": "{{10.id}}"
                },
                "valueInputOption": "USER_ENTERED"
              },
              "metadata": { "designer": { "x": 1200, "y": -400 } }
            },
            {
              "id": 12,
              "module": "google-email:ActionSendEmail",
              "version": 2,
              "parameters": { "__IMTCONN__": null },
              "filter": {
                "name": "Only send if email present",
                "conditions": [
                  [ { "a": "{{1.message.call.metadata.leadEmail}}", "o": "text:notempty" } ]
                ]
              },
              "mapper": {
                "to": [ "{{1.message.call.metadata.leadEmail}}" ],
                "subject": "Your BMC discovery call is confirmed - {{formatDate(parseDate(1.message.analysis.structuredData.meeting_datetime; \"YYYY-MM-DDTHH:mm:ssZ\"); \"dddd, MMM D [at] h:mm A\"; \"Asia/Dubai\")}}",
                "contentType": "html",
                "content": "<p>Hi {{1.message.call.customer.name}},</p><p>Your discovery call with Rafique Hakim is confirmed for <strong>{{formatDate(parseDate(1.message.analysis.structuredData.meeting_datetime; \"YYYY-MM-DDTHH:mm:ssZ\"); \"dddd, MMMM D, YYYY [at] h:mm A\"; \"Asia/Dubai\")}} (UAE time)</strong>.</p><p>A calendar invitation with the Google Meet link has been sent to this email address.</p><p>Looking forward to speaking with you.</p><p>BMC Team</p>",
                "attachments": [],
                "cc": [],
                "bcc": [],
                "replyTo": ""
              },
              "metadata": { "designer": { "x": 1500, "y": -400 } }
            },
            {
              "id": 13,
              "module": "google-sheets:updateRow",
              "version": 4,
              "parameters": { "__IMTCONN__": null },
              "filter": {
                "name": "Only mark Yes if email actually sent",
                "conditions": [
                  [ { "a": "{{1.message.call.metadata.leadEmail}}", "o": "text:notempty" } ]
                ]
              },
              "mapper": {
                "mode": "select",
                "spreadsheetId": "1dl-TPKYxwdgSVsvfYQ8skBEslk4cVjR9x7RfqDJsuiU",
                "sheetId": "Lead Master",
                "includesHeaders": true,
                "rowNumber": "{{1.message.call.metadata.sheetRowNumber}}",
                "values": { "17": "Yes" },
                "valueInputOption": "USER_ENTERED"
              },
              "metadata": { "designer": { "x": 1800, "y": -400 } }
            }
          ]
        },
        {
          "flow": [
            {
              "id": 20,
              "module": "google-sheets:updateRow",
              "version": 4,
              "parameters": { "__IMTCONN__": null },
              "filter": {
                "name": "Busy on Step 2 -> human review",
                "conditions": [
                  [ { "a": "{{1.message.analysis.structuredData.outcome}}", "o": "text:equal", "b": "Busy" } ]
                ]
              },
              "mapper": {
                "mode": "select",
                "spreadsheetId": "1dl-TPKYxwdgSVsvfYQ8skBEslk4cVjR9x7RfqDJsuiU",
                "sheetId": "Lead Master",
                "includesHeaders": true,
                "rowNumber": "{{1.message.call.metadata.sheetRowNumber}}",
                "values": {
                  "6": "Scheduled",
                  "8": "{{formatDate(now; \"YYYY-MM-DD HH:mm\"; \"Asia/Dubai\")}}",
                  "18": "Step 2 - Busy. Flagged for human follow up."
                },
                "valueInputOption": "USER_ENTERED"
              },
              "metadata": { "designer": { "x": 900, "y": 0 } }
            }
          ]
        },
        {
          "flow": [
            {
              "id": 30,
              "module": "google-sheets:updateRow",
              "version": 4,
              "parameters": { "__IMTCONN__": null },
              "filter": {
                "name": "Not Interested -> Dead",
                "conditions": [
                  [ { "a": "{{1.message.analysis.structuredData.outcome}}", "o": "text:equal", "b": "Not Interested" } ]
                ]
              },
              "mapper": {
                "mode": "select",
                "spreadsheetId": "1dl-TPKYxwdgSVsvfYQ8skBEslk4cVjR9x7RfqDJsuiU",
                "sheetId": "Lead Master",
                "includesHeaders": true,
                "rowNumber": "{{1.message.call.metadata.sheetRowNumber}}",
                "values": {
                  "6": "Dead",
                  "8": "{{formatDate(now; \"YYYY-MM-DD HH:mm\"; \"Asia/Dubai\")}}",
                  "18": "Step 2 - Not Interested."
                },
                "valueInputOption": "USER_ENTERED"
              },
              "metadata": { "designer": { "x": 900, "y": 300 } }
            }
          ]
        }
      ]
    }
  ],
  "metadata": {
    "instant": true,
    "version": 1,
    "scenario": {
      "roundtrips": 1,
      "maxErrors": 3,
      "autoCommit": true,
      "autoCommitTriggerLast": true,
      "sequential": false,
      "confidential": false,
      "dataloss": false,
      "dlq": false,
      "freshVariables": false
    },
    "designer": { "orphans": [] },
    "zone": "eu1.make.com",
    "notes": []
  }
}
