                                        { "name": "0", "type": "text", "label": "Lead ID (A)" },
                                        { "name": "1", "type": "text", "label": "Full Name (B)" },
                                        { "name": "2", "type": "text", "label": "Mobile (C)" },
                                        { "name": "3", "type": "text", "label": "Company (D)" },
                                        { "name": "4", "type": "text", "label": "Source Partner (E)" },
                                        { "name": "5", "type": "text", "label": "Lead Email (F)" },
