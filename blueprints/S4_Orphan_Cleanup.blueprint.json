                            "data": {
                                "scoped": "true",
                                "connection": "google"
                            },
                            "label": "My Google connection (tayyeb@nexus54.com)"
                        }
                    }
                }
            }
        },
        {
            "id": 2,
            "module": "google-sheets:updateRow",
            "version": 2,
            "parameters": {
                "__IMTCONN__": 7795130
            },
            "filter": {
                "name": "Stuck > 2 hours",
                "conditions": [
                    [
                        {
                            "a": "{{1.`8`}}",
                            "o": "text:exist"
                        },
                        {
                            "a": "{{parseDate(1.`8`; \"YYYY-MM-DD HH:mm\")}}",
                            "b": "{{addHours(now; -2)}}",
                            "o": "date:less"
                        }
                    ]
                ]
            },
            "mapper": {
                "from": "drive",
                "mode": "select",
                "values": {
                    "6": "Needs Human Review",
                    "8": "{{formatDate(now; \"YYYY-MM-DD HH:mm\")}}",
                    "18": "Stuck > 2h auto-flagged by S4 at {{formatDate(now; \"YYYY-MM-DD HH:mm\")}}"
                },
                "sheetId": "Lead Master",
                "rowNumber": "{{1.__ROW_NUMBER__}}",
                "spreadsheetId": "/1dI-TPKYxwdgSVsvfYQ8skBEslk4cVjR9x7RfqDJsuiU",
                "includesHeaders": true,
                "useColumnHeaders": false,
                "valueInputOption": "USER_ENTERED"
            },
            "metadata": {
                "designer": {
                    "x": 400,
                    "y": 0
                },
                "restore": {
                    "expect": {
                        "from": {
                            "label": "My Drive"
                        },
                        "mode": {
