{
    "name": "BMC — S4 Orphan Cleanup",
    "flow": [
        {
            "id": 1,
            "module": "google-sheets:filterRows",
            "version": 2,
            "parameters": {
                "__IMTCONN__": 7795130
            },
            "mapper": {
                "from": "drive",
                "limit": "50",
                "filter": [
                    [
                        {
                            "a": "G",
                            "b": "Attempting",
                            "o": "text:equal"
                        }
                    ],
                    [
                        {
                            "a": "G",
                            "b": "Step2 Attempting",
                            "o": "text:equal"
                        }
                    ]
                ],
                "sheetId": "Lead Master",
                "sortOrder": "asc",
                "spreadsheetId": "1dI-TPKYxwdgSVsvfYQ8skBEslk4cVjR9x7RfqDJsuiU",
                "tableFirstRow": "A1:CZ1",
                "includesHeaders": true,
                "valueRenderOption": "FORMATTED_VALUE",
                "dateTimeRenderOption": "FORMATTED_STRING"
            },
            "metadata": {
                "designer": {
                    "x": 0,
                    "y": 0
