{
    "name": "BMC — S3a Step 2 Scheduler",
    "flow": [
        {
            "id": 1,
            "module": "google-sheets:filterRows",
            "version": 2,
            "parameters": {
                "__IMTCONN__": 7795130
            },
            "mapper": {
                "from": "drive",
                "mode": "select",
                "filter": [
                    [
                        {
                            "a": "G",
                            "b": "Scheduled",
                            "o": "text:equal"
                        }
                    ]
                ],
                "limit": "25",
                "sheetId": "Lead Master",
                "spreadsheetId": "/1dI-TPKYxwdgSVsvfYQ8skBEslk4cVjR9x7RfqDJsuiU",
                "includesHeaders": true,
                "useColumnHeaders": false,
                "valueRenderOption": "FORMATTED_VALUE",
                "dateTimeRenderOption": "FORMATTED_STRING"
            },
            "metadata": {
                "designer": {
                    "x": 0,
                    "y": 0
                },
                "restore": {
                    "parameters": {
                        "__IMTCONN__": {
                            "label": "My Google connection (tayyeb@nexus54.com)",
                            "data": {
                                "scoped": "true",
                                "connection": "google"
                            }
                        }
                    },
                    "expect": {
                        "from": { "label": "My Drive" },
                        "mode": { "label": "Search by path" },
                        "sheetId": { "label": "Lead Master" },
                        "spreadsheetId": { "path": ["BMC_Lead_Maste -  260530"] },
                        "includesHeaders": { "label": "Yes" },
                        "useColumnHeaders": { "label": "No" },
                        "valueRenderOption": { "mode": "chose", "label": "Formatted value" },
                        "dateTimeRenderOption": { "mode": "chose", "label": "Formatted string" }
                    }
                }
            }
        },
        {
            "id": 2,
            "module": "http:ActionSendDataBasicAuth",
            "version": 3,
            "parameters": {
                "key": 172894,
                "handleErrors": false,
                "useNewZLibDeCompress": true
            },
            "filter": {
                "name": "Due within next 20 min AND inside calling window",
                "conditions": [
                    [
                        { "a": "{{parseDate(1.`Preferred Call DateTime`; \"YYYY-MM-DDTHH:mm:ss\")}}", "b": "{{addMinutes(now; 20)}}", "o": "date:lessorequal" },
                        { "a": "{{parseDate(1.`Preferred Call DateTime`; \"YYYY-MM-DDTHH:mm:ss\")}}", "b": "{{addMinutes(now; -5)}}", "o": "date:greaterorequal" },
                        { "a": "{{formatDate(now; \"d\")}}", "b": "^[2-5]$", "o": "text:pattern" },
                        { "a": "{{formatDate(now; \"HH:mm\")}}", "b": "10:30", "o": "text:greaterorequal" },
                        { "a": "{{formatDate(now; \"HH:mm\")}}", "b": "12:30", "o": "text:lessorequal" }
                    ],
                    [
                        { "a": "{{parseDate(1.`Preferred Call DateTime`; \"YYYY-MM-DDTHH:mm:ss\")}}", "b": "{{addMinutes(now; 20)}}", "o": "date:lessorequal" },
                        { "a": "{{parseDate(1.`Preferred Call DateTime`; \"YYYY-MM-DDTHH:mm:ss\")}}", "b": "{{addMinutes(now; -5)}}", "o": "date:greaterorequal" },
                        { "a": "{{formatDate(now; \"d\")}}", "b": "^[2-5]$", "o": "text:pattern" },
                        { "a": "{{formatDate(now; \"HH:mm\")}}", "b": "15:00", "o": "text:greaterorequal" },
                        { "a": "{{formatDate(now; \"HH:mm\")}}", "b": "17:30", "o": "text:lessorequal" }
                    ]
                ]
            },
            "mapper": {
                "url": "https://api.vapi.ai/call",
                "serializeUrl": false,
                "method": "post",
                "headers": [
                    { "name": "Authorization", "value": "Bearer 9fcc882e-d1c6-448b-b7ad-9fdf662bdeb4" },
                    { "name": "Content-Type", "value": "application/json" }
                ],
                "qs": [],
                "bodyType": "raw",
                "parseResponse": false,
                "timeout": "",
                "shareCookies": false,
                "ca": "",
                "rejectUnauthorized": true,
                "followRedirect": true,
                "useQuerystring": false,
                "gzip": true,
                "useMtls": false,
                "contentType": "application/json",
                "data": "{\r\n  \"assistantId\": \"af6ed5d3-741d-4b2d-b036-6868922df56e\",\r\n  \"phoneNumberId\": \"7e7afc50-0288-4e97-aef2-f781b72b452c\",\r\n  \"customer\": {\r\n    \"number\": \"+{{1.Mobile}}\",\r\n    \"name\": \"{{1.`Full Name`}}\"\r\n  },\r\n  \"assistantOverrides\": {\r\n    \"variableValues\": {\r\n      \"name\": \"{{1.`Full Name`}}\",\r\n      \"company\": \"{{1.Company}}\",\r\n      \"partner_name\": \"{{1.`Source Partner`}}\"\r\n    }\r\n  },\r\n  \"metadata\": {\r\n    \"sheetRowNumber\": \"{{1.__ROW_NUMBER__}}\",\r\n    \"leadEmail\": \"{{1.`Lead Email`}}\",\r\n    \"step\": \"2\"\r\n  }\r\n}",
                "followAllRedirects": false
            },
            "metadata": {
                "designer": { "x": 500, "y": 0 },
                "restore": {
                    "parameters": {
                        "key": { "label": "My HTTP Basic Auth key" }
                    },
                    "expect": {
                        "method": { "mode": "chose", "label": "POST" },
                        "headers": { "mode": "chose", "items": [null, null] },
                        "qs": { "mode": "chose" },
                        "bodyType": { "label": "Raw" },
                        "contentType": { "label": "JSON (application/json)" }
                    }
                }
            }
        },
        {
            "id": 3,
            "module": "google-sheets:updateRow",
            "version": 2,
            "parameters": {
                "__IMTCONN__": 7795130
            },
            "mapper": {
                "mode": "select",
                "valueInputOption": "USER_ENTERED",
                "from": "drive",
                "spreadsheetId": "/1dI-TPKYxwdgSVsvfYQ8skBEslk4cVjR9x7RfqDJsuiU",
                "sheetId": "Lead Master",
                "rowNumber": "{{1.__ROW_NUMBER__}}",
                "includesHeaders": true,
                "useColumnHeaders": false,
                "values": {
                    "8": "{{formatDate(now; \"YYYY-MM-DD HH:mm\")}}",
                    "9": "{{if(parseNumber(formatDate(now; \"HH\")) < 13; \"Morning\"; \"Afternoon\")}}"
                }
            },
            "metadata": {
                "designer": { "x": 1000, "y": 0 },
                "restore": {
                    "parameters": {
                        "__IMTCONN__": {
                            "label": "My Google connection (tayyeb@nexus54.com)",
                            "data": { "scoped": "true", "connection": "google" }
                        }
                    },
                    "expect": {
                        "mode": { "label": "Search by path" },
                        "valueInputOption": { "mode": "chose", "label": "User entered" },
                        "from": { "label": "My Drive" },
                        "spreadsheetId": { "path": ["BMC_Lead_Maste -  260530"] },
                        "sheetId": { "label": "Lead Master" },
                        "includesHeaders": { "label": "Yes" },
                        "useColumnHeaders": { "label": "No" }
                    }
                }
            }
        }
    ],
    "metadata": {
        "instant": false,
        "version": 1,
        "scenario": {
            "roundtrips": 1,
            "maxErrors": 3,
            "autoCommit": true,
            "autoCommitTriggerLast": true,
            "sequential": false,
            "slots": null,
            "confidential": false,
            "dataloss": false,
            "dlq": false,
            "freshVariables": false
        },
        "designer": { "orphans": [] },
        "zone": "eu1.make.com",
        "notes": []
    }
}
