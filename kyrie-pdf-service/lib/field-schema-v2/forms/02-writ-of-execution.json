        { "key": "doc_renewal_orders", "label": "Renewal of Judgment Orders", "type": "checkbox" },
        { "key": "doc_interest_calculations", "label": "Proof of Interest/Fees Calculations", "type": "checkbox" },
        { "key": "doc_previous_writs", "label": "Any Previous Writs", "type": "checkbox" },
        { "key": "doc_debtor_receipts", "label": "Payments or Receipts from Debtor", "type": "checkbox" }
