  "derived": [
    { "key": "amount_remaining_balance", "from": ["amount_judgment_original", "amount_accrued_interest", "amount_costs_added", "amount_payments_made"], "rule": "amount_judgment_original + amount_accrued_interest + amount_costs_added - amount_payments_made" }
  ],
  "intake_groups": [
    {
      "ask": "Walk me through the dollar amounts: original judgment, accrued interest, any costs added after, and any payments the debtor has made. I'll compute the remaining balance.",
      "fills": ["amount_judgment_original", "amount_accrued_interest", "amount_costs_added", "amount_payments_made", "amount_remaining_balance"]
    }
  ]
