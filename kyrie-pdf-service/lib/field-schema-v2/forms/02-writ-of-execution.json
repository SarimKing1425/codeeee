        { "key": "additional_debtor_2_name", "label": "Additional Debtor 2 Name", "type": "text", "show_if": "has_multiple_debtors == yes" },
        { "key": "additional_debtor_3_name", "label": "Additional Debtor 3 Name", "type": "text", "show_if": "has_multiple_debtors == yes" }
      ]
